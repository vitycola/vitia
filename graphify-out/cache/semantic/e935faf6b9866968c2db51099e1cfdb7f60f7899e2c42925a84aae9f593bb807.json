{"nodes": [{"id": "web_pwa_migration_design", "label": "PWA Migration Design (Slice 1)", "file_type": "document", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_wasqlite_opfs", "label": "wa-sqlite + OPFS Engine", "file_type": "concept", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Architecture Decisions #2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over sql.js (no durable OPFS) and absurd-sql (unmaintained). Maintained WASM SQLite with first-class OPFS and sync-access-handle VFS. Requires crossOriginIsolated."}, {"id": "design_dexie_indexeddb_fallback", "label": "Dexie/IndexedDB Primary iOS Fallback", "file_type": "rationale", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Architecture Decisions #4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "iOS Safari often lacks sync access handle (iOS \u226416.3), making Dexie the EXPECTED path on many iPhones, not an edge case. Rejected IDBBatchAtomicVFS bridge as fragile/slow on iOS Safari. Dexie adapter re-implements all 3 repo contracts against flat IndexedDB tables."}, {"id": "design_drizzle_sqlite_proxy", "label": "drizzle-orm/sqlite-proxy Binding", "file_type": "concept", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Architecture Decisions #3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Official escape hatch so schema + repos see an identical db object. Requires a custom transaction facade because the plain async-proxy driver does NOT provide an interactive tx callback."}, {"id": "design_react_router_v7", "label": "React Router v7 (createBrowserRouter)", "file_type": "concept", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Architecture Decisions #1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over TanStack Router. Only ~6 flat routes, no nested-layout depth or type-safe-search needs that justify TanStack's heavier API + route codegen. React Router maps 1:1 to existing routes, lowest migration cost."}, {"id": "design_db_transaction_facade", "label": "db.transaction() Facade (Worker BEGIN/COMMIT)", "file_type": "rationale", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "CRITICAL: Transactions across the Worker boundary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mealEntries.ts uses db.transaction() at lines 53 and 70. sqlite-proxy has no interactive tx callback. Resolution: thin facade in db/client.ts adds real transaction(fn) whose tx is a drizzle-proxy bound to the same Worker, with Worker serializing statements between BEGIN/COMMIT/ROLLBACK. Zero repo changes required."}, {"id": "design_web_migrator", "label": "From-Scratch Web Migrator (Vite ?raw)", "file_type": "rationale", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "CRITICAL: From-scratch web migrator", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "expo migrator is RN-only and incompatible with sqlite-proxy. Web migrator imports .sql files via Vite ?raw, splits on --> statement-breakpoint, tracks in __drizzle_migrations table with hash drift guard."}, {"id": "design_coop_coep_headers", "label": "COOP/COEP Headers (crossOriginIsolated)", "file_type": "concept", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "COOP/COEP Headers section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required for OPFS sync VFS (OPFSCoopSyncVFS). Configured per host: Vercel vercel.json, Netlify _headers/netlify.toml, Cloudflare Pages _headers. If absent or iOS lacks VFS, probe fails \u2192 Dexie fallback."}, {"id": "design_offline_guard_ui_layer", "label": "Offline Guard at UI/Store-Caller Layer", "file_type": "rationale", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Architecture Decisions #6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guard placed at UI layer, not inside lib/openFoodFacts.ts, because lib/ is reused 1:1 and must not be touched. SearchRoute checks navigator.onLine before invoking store's search()."}, {"id": "design_db_ready_gate", "label": "dbReady Promise Gate (main.tsx)", "file_type": "concept", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Architecture Decisions #7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main.tsx awaits dbReady before mounting RouterProvider. Repos must not run before migrations complete."}, {"id": "design_contract_test_suite", "label": "Repository Contract Test Suite (describe.each both backends)", "file_type": "concept", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Shared Contract Test Suite section", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_data_flow", "label": "Data Flow: Screen \u2192 Zustand \u2192 Repos \u2192 db facade", "file_type": "rationale", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Data Flow section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screens dispatch actions to Zustand stores, which call db/repositories, which call the db facade. The facade routes to either wa-sqlite Worker (OPFS) or Dexie/IndexedDB depending on probe result."}, {"id": "design_vite_plugin_pwa", "label": "vite-plugin-pwa + Workbox", "file_type": "concept", "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Service Worker / PWA section", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "web_pwa_migration_design", "target": "web_pwa_migration_proposal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "header", "weight": 1.0}, {"source": "web_pwa_migration_design", "target": "design_wasqlite_opfs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Decision #2", "weight": 1.0}, {"source": "web_pwa_migration_design", "target": "design_dexie_indexeddb_fallback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Decision #4", "weight": 1.0}, {"source": "web_pwa_migration_design", "target": "design_drizzle_sqlite_proxy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Decision #3", "weight": 1.0}, {"source": "web_pwa_migration_design", "target": "design_react_router_v7", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "Decision #1", "weight": 1.0}, {"source": "web_pwa_migration_design", "target": "design_db_transaction_facade", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/web-pwa-migration/design.md", "source_location": "CRITICAL: Transactions section", "weight": 1.0}, {"source": "web_pwa_migration_design", "target": "design_web_migrator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/web-pwa-migration/design.m