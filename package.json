{
  "name": "vitia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests --forceExit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@supabase/supabase-js": "^2.108.2",
    "dexie": "^4.4.4",
    "drizzle-orm": "^0.44.1",
    "lucide-react": "^1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.4",
    "react-router-dom": "^7.18.0",
    "wa-sqlite": "^1.0.0",
    "workbox-window": "^7.4.1",
    "zod": "^3.24.4",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --no-errors-on-unmatched"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-jsx",
            "isolatedModules": true,
            "esModuleInterop": true
          }
        }
      ],
      "^.+\\.sql$": "<rootDir>/jest.sql-transform.js"
    },
    "moduleNameMapper": {
      "^@/(.+\\.sql)\\?raw$": "<rootDir>/$1",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
